datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Booking {
  id              String    @id
  slotKey         String?
  name            String
  phone           String
  package         String
  region          String?
  dates           String
  guests          Int
  roomType        String
  addons          Json?
  total           Float
  status          String    @default("Pending")
  source          String    @default("Website Booking Engine")
  notes           String?
  razorpayOrderId String?   @unique
  paymentId       String?
  paidAt          DateTime?
  holdExpiresAt   BigInt?
  refundReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([slotKey])
  @@index([createdAt])
}

model WebhookEvent {
  id          String   @id
  event       String
  processedAt DateTime @default(now())
  payload     Json?

  @@index([event])
}

model CampOverride {
  id        String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

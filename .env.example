# ─────────────────────────────────────────────────────────────
# AANANDHAM.GO — PRODUCTION & LOCAL ENVIRONMENT SETUP (.env.local)
# Copy this file to .env.local to configure your live credentials.
# ─────────────────────────────────────────────────────────────

# ── 1. 🛡️ ADMIN COORDINATOR CREDENTIALS (MANDATORY FOR /admin) ──
# Passcode used by basecamp coordinators to log into the Admin Command Center (16+ characters).
ADMIN_PASSCODE=YOUR_SECURE_RANDOM_ADMIN_PASSCODE_MIN_16_CHARS

# High-entropy 32+ char secret string for HMAC-SHA256 JWT admin session signing.
# Generate via: openssl rand -hex 32
ADMIN_AUTH_SECRET=YOUR_CUSTOM_RANDOM_32_CHAR_HEX_SECRET_KEY_HERE

# ── 2. 🗄️ DATABASE CONFIGURATION (POSTGRESQL / PRISMA) ──
# Connect any PostgreSQL database (Neon.tech, Supabase, Railway, Vercel Postgres, or local Docker).
# If left blank, the app automatically runs in High-Speed Local In-Memory Mode!
DATABASE_URL="postgresql://postgres:password@localhost:5432/aanandham_db?schema=public"

# ── 3. ⚡ REDIS CACHE & RATE LIMITING (UPSTASH REDIS - OPTIONAL) ──
# Used for sliding-window DDoS protection, live waitlists, and token revoking.
# Get free credentials at https://upstash.com (or leave empty to use built-in memory store).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── 4. 📞 WHATSAPP & NOTIFICATION CHANNELS ──
# Basecamp coordinator WhatsApp number (in international format without + sign, e.g. 919400987654)
NEXT_PUBLIC_ADMIN_WHATSAPP=919400987654
NEXT_PUBLIC_ADMIN_TELEGRAM=@aanandham_dispatch_bot

# ── 5. 💳 PAYMENT GATEWAY (UPI / RAZORPAY / CASHFREE - OPTIONAL) ──
# If using direct UPI QR, campers pay 0 fees. If using Razorpay automated checkout:
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ── 6. 🌐 APPLICATION DOMAIN ──
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── 7. 🔍 GOOGLE SEARCH CONSOLE & WEBMASTER VERIFICATION ──
# Paste your Google HTML tag verification code (e.g. from <meta name="google-site-verification" content="XYZ" />)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# ── 8. 🖼️ SUPABASE STORAGE (For Admin Photo Uploads — OPTIONAL but Recommended) ──
# Sign up free at https://supabase.com → Create project → Settings → API
# Free tier: 1 GB storage, 2 GB bandwidth/month. Zero extra cost.
#
# HOW TO SETUP:
#   1. Go to https://supabase.com/dashboard → Your Project → Storage
#   2. Create a new bucket called: aanandham-media
#   3. Set bucket visibility to PUBLIC (so CDN URLs work for the website)
#   4. Copy your project URL and keys below
#
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Service role key — KEEP THIS SECRET (server-side only, never expose to browser)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── 9. 📧 AUTOMATED CONFIRMATION EMAILS & DIGITAL PASSES (RESEND - OPTIONAL) ──
# Sign up free at https://resend.com (100 free emails/day, 3,000/month on Free tier).
# Generates beautiful HTML passes with Gate Access PINs, Scannable QR Codes, and 4x4 Convoy Guides.
#
RESEND_API_KEY=""
EMAIL_FROM="Aanandham Wilderness <bookings@aanandham.in>"
NEXT_PUBLIC_SITE_URL="https://aanandham.in"
